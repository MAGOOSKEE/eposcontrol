// EposControl main window. Layout follows the familiar three page structure:
// output (EQ and surround), microphone, settings.

export global Backend {
    in-out property <[float]> eq: [0, 0, 0, 0, 0, 0, 0, 0, 0];
    in-out property <int> preset;
    in property <string> preset-label: "FLAT";
    in property <[string]> preset-names;
    in-out property <bool> surround;
    in-out property <float> reverb;
    in-out property <int> voice;
    in-out property <float> gain;
    in-out property <float> gate;
    in-out property <int> nc;
    in-out property <float> volume;
    in property <[float]> spectrum: [-120, -120, -120, -120, -120, -120, -120, -120, -120, -120, -120, -120, -120, -120, -120];
    in property <bool> connected;
    in property <string> playback-name: "EPOS GSX 300";
    in property <string> recording-name: "EPOS GSX 300";
    in property <string> version;
    in-out property <int> action-index;
    in-out property <string> action-param;
    in property <[string]> action-names;
    in property <string> param-hint;
    in property <bool> param-visible;
    in-out property <int> led-index;
    in-out property <bool> autostart;

    callback eq-moved(int, float);
    callback preset-selected(int);
    callback preset-add();
    callback surround-set(bool);
    callback reverb-set(float);
    callback voice-set(int);
    callback gain-set(float);
    callback gate-set(float);
    callback nc-set(int);
    callback volume-set(float);
    callback refresh-volume();
    callback poll-spectrum();
    callback page-changed(int);
    callback led-selected(int);
    callback action-selected(int);
    callback param-edited(string);
    callback autostart-toggled(bool);
    callback drag-window();
    callback minimize();
    callback close();
}

global Theme {
    out property <color> accent: #3df0d2;
    out property <color> text: #e6f0f0;
    out property <color> dim: #8fa9ab;
    out property <color> panel: #0a181c;
    out property <brush> backdrop: @linear-gradient(180deg, #1b5057 0%, #122a30 55%, #0e1b1f 100%);
}

component Cap inherits Text {
    color: Theme.dim;
    font-size: 11px;
    letter-spacing: 1.2px;
    font-weight: 600;
}

component IconBtn inherits Rectangle {
    in property <image> icon;
    in property <color> tint: Theme.text;
    in property <length> glyph: 22px;
    callback clicked;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: area.has-hover ? Theme.text.with-alpha(0.10) : transparent;
    Image {
        source: root.icon;
        width: root.glyph;
        height: root.glyph;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: root.tint;
    }
    area := TouchArea { clicked => { root.clicked(); } }
}

component Dropdown inherits Rectangle {
    in property <string> label;
    in property <[string]> items;
    in property <length> menu-width: 150px;
    callback picked(int);
    callback opened();
    height: 32px;
    width: row.preferred-width + 8px;
    background: area.has-hover ? Theme.text.with-alpha(0.08) : transparent;
    border-radius: 4px;
    row := HorizontalLayout {
        padding-left: 6px;
        spacing: 0px;
        Text {
            text: root.label;
            color: Theme.text;
            font-size: 12px;
            letter-spacing: 0.8px;
            vertical-alignment: center;
        }
        Image {
            source: @image-url("../../../assets/icons/arrow_drop_down.svg");
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            colorize: Theme.text;
        }
    }
    area := TouchArea { clicked => { root.opened(); pop.show(); } }
    pop := PopupWindow {
        x: root.width - root.menu-width;
        y: root.height + 2px;
        width: root.menu-width;
        Rectangle {
            background: #0c1d22;
            border-width: 1px;
            border-color: Theme.accent.with-alpha(0.35);
            VerticalLayout {
                padding: 4px;
                for item[i] in root.items: Rectangle {
                    height: 32px;
                    background: ia.has-hover ? Theme.accent.with-alpha(0.16) : transparent;
                    Text {
                        x: 12px;
                        text: item;
                        color: Theme.text;
                        font-size: 12px;
                        letter-spacing: 0.6px;
                        vertical-alignment: center;
                    }
                    ia := TouchArea { clicked => { root.picked(i); } }
                }
            }
        }
    }
}

component Slim inherits Rectangle {
    in-out property <float> value;
    in property <bool> enabled: true;
    callback changed(float);
    height: 24px;
    opacity: root.enabled ? 1.0 : 0.4;
    Rectangle { y: (parent.height - 1px) / 2; height: 1px; background: Theme.dim; }
    Rectangle {
        y: (parent.height - 1px) / 2;
        height: 1px;
        width: root.value * (parent.width - 14px) + 7px;
        background: Theme.accent;
    }
    Rectangle {
        width: 14px;
        height: 14px;
        border-radius: 7px;
        x: root.value * (parent.width - 14px);
        y: (parent.height - self.height) / 2;
        background: white;
    }
    ta := TouchArea {
        enabled: root.enabled;
        function upd() {
            root.value = max(0.0, min(1.0, (self.mouse-x - 7px) / (self.width - 14px)));
            root.changed(root.value);
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { self.upd(); }
        }
        moved => { self.upd(); }
    }
}

component Seg2 inherits HorizontalLayout {
    in property <string> a;
    in property <string> b;
    in property <int> index;
    callback picked(int);
    spacing: 0px;
    for t[i] in [root.a, root.b]: Rectangle {
        width: 56px;
        height: 36px;
        background: root.index == i ? Theme.accent.with-alpha(0.10) : Theme.panel.with-alpha(0.5);
        border-width: 1px;
        border-color: root.index == i ? Theme.accent : Theme.dim.with-alpha(0.35);
        Text {
            text: t;
            color: root.index == i ? Theme.accent : Theme.text;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea { clicked => { root.picked(i); } }
    }
}

component Steps3 inherits Rectangle {
    in property <int> index;
    callback picked(int);
    height: 24px;
    Rectangle { y: (parent.height - 1px) / 2; height: 1px; background: Theme.dim; }
    for i in 3: Rectangle {
        width: root.index == i ? 12px : 7px;
        height: self.width;
        border-radius: self.width / 2;
        x: i * (root.width - 12px) / 2 + (12px - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: root.index == i ? white : Theme.text;
    }
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.picked(self.mouse-x < root.width / 3 ? 0 : (self.mouse-x < root.width * 2 / 3 ? 1 : 2));
            }
        }
    }
}

component EqGraph inherits Rectangle {
    property <length> lw: 60px;
    property <length> cw: (root.width - lw) / 9;
    property <int> dragging: -1;
    pure function py(db: float) -> length { return (6 - db) / 12 * root.height; }
    pure function px(i: int) -> length { return lw + (i + 0.5) * cw; }
    pure function n(v: length) -> float { return v / 1px; }

    for lab[k] in ["+6", "+3", "0", "-3", "-6"]: Text {
        x: 0px;
        y: k * root.height / 4 - 8px;
        width: lw - 16px;
        height: 16px;
        text: lab;
        color: Theme.text;
        font-size: 12px;
        horizontal-alignment: right;
    }
    for i in 9: Rectangle {
        x: px(i);
        width: 1px;
        height: root.height;
        background: Theme.dim.with-alpha(0.22);
    }
    Rectangle {
        x: lw;
        y: py(0);
        width: root.width - lw;
        height: 1px;
        background: Theme.accent.with-alpha(0.7);
    }
    Path {
        width: root.width;
        height: root.height;
        stroke: Theme.accent;
        stroke-width: 1.5px;
        commands: "M \{n(px(0))} \{n(py(Backend.eq[0]))} L \{n(px(1))} \{n(py(Backend.eq[1]))} L \{n(px(2))} \{n(py(Backend.eq[2]))} L \{n(px(3))} \{n(py(Backend.eq[3]))} L \{n(px(4))} \{n(py(Backend.eq[4]))} L \{n(px(5))} \{n(py(Backend.eq[5]))} L \{n(px(6))} \{n(py(Backend.eq[6]))} L \{n(px(7))} \{n(py(Backend.eq[7]))} L \{n(px(8))} \{n(py(Backend.eq[8]))}";
    }
    for i in 9: Rectangle {
        x: px(i) - 4px;
        y: py(Backend.eq[i]) - 4px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: white;
    }
    for i in 9: Text {
        x: px(i) - 30px;
        y: root.height + 14px;
        width: 60px;
        text: ["64", "125", "250", "500", "1k", "2k", "4k", "8k", "16k"][i];
        color: Theme.text;
        font-size: 12px;
        horizontal-alignment: center;
    }
    for i in 9: TouchArea {
        x: lw + i * cw;
        width: cw;
        height: root.height;
        function upd() {
            Backend.eq[i] = round((6 - max(0px, min(root.height, self.mouse-y)) / root.height * 12) * 20) / 20;
            Backend.eq-moved(i, Backend.eq[i]);
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.dragging = i; self.upd(); }
            else if (e.kind == PointerEventKind.up) { root.dragging = -1; }
        }
        moved => { self.upd(); }
    }
    if root.dragging >= 0: Rectangle {
        x: px(root.dragging) - 32px;
        y: py(Backend.eq[root.dragging]) - 46px;
        width: 64px;
        height: 22px;
        Text {
            text: (Backend.eq[root.dragging] >= 0 ? "+" : "") + round(Backend.eq[root.dragging] * 100) / 100 + " dB";
            color: white;
            font-size: 13px;
            font-weight: 700;
            horizontal-alignment: center;
        }
    }
}

component OutputPage inherits Rectangle {
    EqGraph {
        x: 48px;
        y: 60px;
        width: parent.width - 96px;
        height: 230px;
    }
    Cap { x: 100px; y: 350px; text: "SURROUND"; }
    Text { x: 100px; y: 366px; text: "EFFECT"; color: Theme.dim; font-size: 10px; letter-spacing: 1px; }
    Cap { x: 100px; y: 404px; text: "MODE"; }
    Seg2 {
        x: 150px;
        y: 392px;
        a: "2.0";
        b: "7.1";
        index: Backend.surround ? 1 : 0;
        picked(i) => { Backend.surround = i == 1; Backend.surround-set(i == 1); }
    }
    Cap {
        x: 340px;
        y: 404px;
        text: "REVERBERATION";
        opacity: Backend.surround ? 1.0 : 0.4;
    }
    Slim {
        x: 490px;
        y: 398px;
        width: 220px;
        enabled: Backend.surround;
        value <=> Backend.reverb;
        changed(v) => { Backend.reverb-set(v); }
    }
    Text {
        x: 340px;
        y: 428px;
        text: Backend.surround ? "" : "Reverberation is available in 7.1 mode";
        color: Theme.dim;
        font-size: 11px;
    }
}

component MicPage inherits Rectangle {
    // Live microphone spectrum (written by the audio driver).
    Rectangle {
        x: 48px;
        y: 50px;
        width: parent.width - 96px;
        height: 170px;
        for v[i] in Backend.spectrum: Rectangle {
            property <length> h: max(3px, min(170px, (v + 80) / 70 * 170px));
            width: 3px;
            height: self.h;
            x: 36px + i * (parent.width - 72px) / 15;
            y: parent.height - self.h;
            background: Theme.accent;
            opacity: 0.85;
        }
        Rectangle { y: parent.height; height: 1px; background: Theme.dim.with-alpha(0.4); }
    }
    Cap { x: 100px; y: 260px; text: "MIC OPTIONS"; }
    Text { x: 100px; y: 276px; text: "MODIFY AND ADJUST"; color: Theme.dim; font-size: 10px; letter-spacing: 1px; }

    Cap { x: 100px; y: 330px; text: "VOICE ENHANCER"; }
    Rectangle {
        x: 100px;
        y: 352px;
        width: 130px;
        height: 36px;
        background: Theme.panel.with-alpha(0.6);
        border-width: 1px;
        border-color: Theme.dim.with-alpha(0.35);
        Text {
            x: 12px;
            text: ["OFF", "WARM", "CLEAR"][Backend.voice];
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
        }
        Image {
            x: parent.width - 28px;
            y: (parent.height - self.height) / 2;
            width: 22px;
            height: 22px;
            source: @image-url("../../../assets/icons/arrow_drop_down.svg");
            colorize: Theme.text;
        }
        Dropdown {
            width: parent.width;
            height: parent.height;
            label: "";
            items: ["OFF", "WARM", "CLEAR"];
            menu-width: 130px;
            picked(i) => { Backend.voice = i; Backend.voice-set(i); }
        }
    }

    Cap { x: 270px; y: 330px; text: "GAIN"; color: Theme.accent; }
    Slim { x: 270px; y: 358px; width: 150px; value <=> Backend.gain; changed(v) => { Backend.gain-set(v); } }
    Cap { x: 460px; y: 330px; text: "NOISE GATE"; }
    Slim { x: 460px; y: 358px; width: 150px; value <=> Backend.gate; changed(v) => { Backend.gate-set(v); } }
    Cap { x: 650px; y: 330px; text: "NOISE CANCELLATION"; }
    Steps3 {
        x: 650px;
        y: 358px;
        width: 150px;
        index: Backend.nc;
        picked(i) => { Backend.nc = i; Backend.nc-set(i); }
    }
}

component SettingsPage inherits Rectangle {
    Text { x: 100px; y: 36px; text: "SETTINGS"; color: Theme.text; font-size: 30px; font-weight: 300; letter-spacing: 1px; }
    Rectangle { x: 100px; y: 96px; width: 230px; height: 1px; background: Theme.accent.with-alpha(0.55); }

    Text { x: 104px; y: 128px; text: "STATUS"; color: Theme.text; font-size: 13px; font-weight: 700; letter-spacing: 0.8px; }
    Text { x: 104px; y: 150px; text: "SOFTWARE VERSION: " + Backend.version; color: Theme.dim; font-size: 10px; letter-spacing: 0.6px; }
    Text { x: 104px; y: 176px; text: "DEVICE"; color: Theme.text; font-size: 13px; font-weight: 700; letter-spacing: 0.8px; }
    Text {
        x: 104px;
        y: 198px;
        text: Backend.connected ? "GSX 300 CONNECTED" : "GSX 300 NOT FOUND";
        color: Backend.connected ? Theme.accent : Theme.dim;
        font-size: 10px;
        letter-spacing: 0.6px;
    }

    Rectangle {
        x: 400px;
        y: 28px;
        width: parent.width - 440px;
        height: 316px;
        background: Theme.panel.with-alpha(0.55);
        Cap { x: 14px; y: 14px; text: "PLAYBACK DEVICE"; font-size: 10px; }
        Text { x: 14px; y: 32px; text: Backend.playback-name; color: Theme.text; font-size: 12px; }

        Cap { x: 14px; y: 70px; text: "SMART BUTTON"; font-size: 10px; color: Theme.accent; }
        Dropdown {
            x: 8px;
            y: 86px;
            label: Backend.action-names[Backend.action-index];
            items: Backend.action-names;
            menu-width: 260px;
            picked(i) => { Backend.action-index = i; Backend.action-selected(i); }
        }
        if Backend.param-visible: Rectangle {
            x: 14px;
            y: 124px;
            width: parent.width - 28px;
            height: 34px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.dim.with-alpha(0.4);
            TextInput {
                x: 10px;
                width: parent.width - 20px;
                text: Backend.action-param;
                color: Theme.text;
                font-size: 12px;
                vertical-alignment: center;
                edited => { Backend.param-edited(self.text); }
            }
        }
        if Backend.param-visible: Text {
            x: 14px;
            y: 162px;
            width: parent.width - 28px;
            text: Backend.param-hint;
            color: Theme.dim;
            font-size: 10px;
            wrap: word-wrap;
        }

        Cap { x: 14px; y: 196px; text: "KNOB LIGHT"; font-size: 10px; color: Theme.accent; }
        for name[i] in ["OFF", "RED", "BLUE", "PURPLE"]: Rectangle {
            x: 14px + i * 82px;
            y: 218px;
            width: 74px;
            height: 32px;
            background: Backend.led-index == i ? Theme.accent.with-alpha(0.12) : transparent;
            border-width: 1px;
            border-color: Backend.led-index == i ? Theme.accent : Theme.dim.with-alpha(0.35);
            Rectangle {
                x: 10px;
                y: (parent.height - 10px) / 2;
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: [#00000000, #e53935, #1e88e5, #9c27b0][i];
                border-width: 1px;
                border-color: Theme.dim.with-alpha(0.6);
            }
            Text { x: 28px; text: name; color: Theme.text; font-size: 10px; vertical-alignment: center; }
            TouchArea { clicked => { Backend.led-index = i; Backend.led-selected(i); } }
        }

        Cap { x: 14px; y: 266px; text: "RECORDING DEVICE"; font-size: 10px; }
        Text { x: 14px; y: 284px; text: Backend.recording-name; color: Theme.text; font-size: 12px; }
    }

    Rectangle {
        x: 400px;
        y: 358px;
        width: 150px;
        height: 66px;
        background: Theme.panel.with-alpha(0.55);
        VerticalLayout {
            alignment: center;
            spacing: 6px;
            Text { text: "SHOW ON STARTUP"; color: Theme.accent; font-size: 10px; letter-spacing: 0.8px; horizontal-alignment: center; }
            Text { text: Backend.autostart ? "Enabled" : "Disabled"; color: Theme.dim; font-size: 11px; horizontal-alignment: center; }
        }
        TouchArea { clicked => { Backend.autostart = !Backend.autostart; Backend.autostart-toggled(Backend.autostart); } }
    }
}

export component MainWindow inherits Window {
    no-frame: true;
    width: 1040px;
    height: 590px;
    title: "EposControl";
    background: #122a30;
    property <int> page: 0;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: Theme.backdrop;
    }

    Timer {
        interval: 60ms;
        running: root.page == 1;
        triggered => { Backend.poll-spectrum(); }
    }

    // Title bar
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 64px;
        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    Backend.drag-window();
                }
            }
        }
        Text {
            x: 40px;
            y: 22px;
            text: "EPOSCONTROL";
            color: Theme.text;
            font-size: 18px;
            font-weight: 300;
            letter-spacing: 3px;
        }
        HorizontalLayout {
            x: 0px;
            width: parent.width - 24px;
            y: 14px;
            height: 36px;
            spacing: 14px;
            alignment: end;
            if root.page != 2: Dropdown {
                label: Backend.preset-label;
                items: Backend.preset-names;
                menu-width: 170px;
                picked(i) => { Backend.preset-selected(i); }
            }
            if root.page == 0: IconBtn {
                icon: @image-url("../../../assets/icons/add_box.svg");
                tint: Theme.accent;
                clicked => { Backend.preset-add(); }
            }
            Dropdown {
                label: "VOLUME";
                items: [];
                opened() => { Backend.refresh-volume(); vol.show(); }
            }
            IconBtn {
                icon: @image-url("../../../assets/icons/remove.svg");
                glyph: 18px;
                clicked => { Backend.minimize(); }
            }
            IconBtn {
                icon: @image-url("../../../assets/icons/close.svg");
                glyph: 18px;
                clicked => { Backend.close(); }
            }
        }
    }
    vol := PopupWindow {
        x: root.width - 250px;
        y: 60px;
        width: 220px;
        height: 56px;
        Rectangle {
            background: #0c1d22;
            border-width: 1px;
            border-color: Theme.accent.with-alpha(0.35);
            Slim {
                x: 14px;
                y: 16px;
                width: parent.width - 28px;
                value <=> Backend.volume;
                changed(v) => { Backend.volume-set(v); }
            }
        }
    }

    // Pages
    if root.page == 0: OutputPage { x: 0px; y: 64px; width: parent.width; height: 456px; }
    if root.page == 1: MicPage { x: 0px; y: 64px; width: parent.width; height: 456px; }
    if root.page == 2: SettingsPage { x: 0px; y: 64px; width: parent.width; height: 456px; }

    // Bottom navigation
    Rectangle {
        x: 0px;
        y: 520px;
        width: parent.width;
        height: 70px;
        Rectangle { y: 0px; height: 1px; background: Theme.dim.with-alpha(0.35); }
        HorizontalLayout {
            alignment: center;
            spacing: 80px;
            for ic[i] in [
                @image-url("../../../assets/icons/headphones.svg"),
                @image-url("../../../assets/icons/record_voice_over.svg"),
                @image-url("../../../assets/icons/settings.svg")
            ]: IconBtn {
                width: 44px;
                height: 44px;
                glyph: 28px;
                y: 14px;
                icon: ic;
                tint: root.page == i ? Theme.accent : Theme.text;
                clicked => { root.page = i; Backend.page-changed(i); }
            }
        }
    }
}
