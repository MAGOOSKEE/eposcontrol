// EposControl main window: three pages (output, microphone, settings) built from
// rounded cards on a dark graphite backdrop with a blue to violet accent.

export global Backend {
    in-out property <[float]> eq: [0, 0, 0, 0, 0, 0, 0, 0, 0];
    in-out property <int> preset;
    in property <string> preset-label: "FLAT";
    in property <[string]> preset-names;
    in-out property <bool> surround;
    in-out property <float> reverb;
    in-out property <int> voice;
    in-out property <float> gain;
    in-out property <float> gate;
    in-out property <int> nc;
    in-out property <float> volume;
    in property <[float]> spectrum: [-120, -120, -120, -120, -120, -120, -120, -120, -120, -120, -120, -120, -120, -120, -120];
    in property <bool> connected;
    in property <string> playback-name: "EPOS GSX 300";
    in property <string> recording-name: "EPOS GSX 300";
    in property <string> version;
    in-out property <int> action-index;
    in-out property <string> action-param;
    in property <[string]> action-names;
    in property <string> param-hint;
    in property <bool> param-visible;
    in-out property <int> led-index;
    in-out property <bool> autostart;

    callback eq-moved(int, float);
    callback preset-selected(int);
    callback preset-add();
    callback surround-set(bool);
    callback reverb-set(float);
    callback voice-set(int);
    callback gain-set(float);
    callback gate-set(float);
    callback nc-set(int);
    callback volume-set(float);
    callback refresh-volume();
    callback poll-spectrum();
    callback page-changed(int);
    callback led-selected(int);
    callback action-selected(int);
    callback param-edited(string);
    callback autostart-toggled(bool);
    callback drag-window();
    callback minimize();
    callback close();
}

global Theme {
    out property <color> accent: #6ea8ff;
    out property <color> accent2: #b987ff;
    out property <color> text: #eef1f8;
    out property <color> dim: #8b94ab;
    out property <color> surface: #1a2031;
    out property <color> surface-hi: #252d44;
    out property <color> edge: #ffffff12;
    out property <brush> backdrop: @linear-gradient(165deg, #151a2b 0%, #0e111b 100%);
    out property <brush> aurora: @linear-gradient(90deg, #6ea8ff 0%, #b987ff 100%);
}

component Cap inherits Text {
    color: Theme.dim;
    font-size: 11px;
    letter-spacing: 1.2px;
    font-weight: 700;
}

component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: 16px;
    border-width: 1px;
    border-color: Theme.edge;
}

component IconBtn inherits Rectangle {
    in property <image> icon;
    in property <color> tint: Theme.text;
    in property <length> glyph: 22px;
    callback clicked;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: area.has-hover ? Theme.text.with-alpha(0.10) : transparent;
    Image {
        source: root.icon;
        width: root.glyph;
        height: root.glyph;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: root.tint;
    }
    area := TouchArea { clicked => { root.clicked(); } }
}

component Dropdown inherits Rectangle {
    in property <string> label;
    in property <[string]> items;
    in property <length> menu-width: 170px;
    in property <bool> boxed: true;
    callback picked(int);
    callback opened();
    height: 34px;
    width: max(row.preferred-width + 8px, 90px);
    background: area.has-hover ? Theme.surface-hi : (root.boxed ? Theme.surface : transparent);
    border-radius: 17px;
    border-width: root.boxed ? 1px : 0px;
    border-color: Theme.edge;
    row := HorizontalLayout {
        padding-left: 14px;
        padding-right: 6px;
        spacing: 0px;
        Text {
            text: root.label;
            color: Theme.text;
            font-size: 12px;
            letter-spacing: 0.8px;
            vertical-alignment: center;
        }
        Image {
            source: @image-url("../../../assets/icons/arrow_drop_down.svg");
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            colorize: Theme.dim;
        }
    }
    area := TouchArea { clicked => { root.opened(); pop.show(); } }
    pop := PopupWindow {
        x: root.width - root.menu-width;
        y: root.height + 4px;
        width: root.menu-width;
        Rectangle {
            background: Theme.surface-hi;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.edge;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                for item[i] in root.items: Rectangle {
                    height: 32px;
                    border-radius: 8px;
                    background: ia.has-hover ? Theme.accent.with-alpha(0.18) : transparent;
                    Text {
                        x: 12px;
                        text: item;
                        color: Theme.text;
                        font-size: 12px;
                        letter-spacing: 0.6px;
                        vertical-alignment: center;
                    }
                    ia := TouchArea { clicked => { root.picked(i); } }
                }
            }
        }
    }
}

component Slim inherits Rectangle {
    in-out property <float> value;
    in property <bool> enabled: true;
    callback changed(float);
    height: 28px;
    opacity: root.enabled ? 1.0 : 0.35;
    Rectangle {
        x: 0px;
        y: (parent.height - 4px) / 2;
        width: parent.width;
        height: 4px;
        border-radius: 2px;
        background: Theme.surface-hi;
    }
    Rectangle {
        x: 0px;
        y: (parent.height - 4px) / 2;
        width: root.value * (parent.width - 18px) + 9px;
        height: 4px;
        border-radius: 2px;
        background: Theme.aurora;
    }
    Rectangle {
        x: root.value * (parent.width - 18px);
        y: (parent.height - 18px) / 2;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: white;
        border-width: 3px;
        border-color: Theme.accent;
    }
    TouchArea {
        enabled: root.enabled;
        function upd() {
            root.value = max(0.0, min(1.0, (self.mouse-x - 9px) / (self.width - 18px)));
            root.changed(root.value);
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { self.upd(); }
        }
        moved => { self.upd(); }
    }
}

component Toggle inherits Rectangle {
    in-out property <bool> on;
    callback toggled(bool);
    width: 50px;
    height: 28px;
    border-radius: 14px;
    background: root.on ? Theme.accent : Theme.surface-hi;
    Rectangle {
        x: root.on ? 25px : 3px;
        y: 3px;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: white;
        animate x { duration: 120ms; }
    }
    TouchArea { clicked => { root.on = !root.on; root.toggled(root.on); } }
}

component Pills inherits Rectangle {
    in property <[string]> labels;
    in property <int> index;
    in property <length> cell: 64px;
    callback picked(int);
    height: 38px;
    width: root.labels.length * root.cell + 8px;
    border-radius: 19px;
    background: Theme.surface-hi;
    for t[i] in root.labels: Rectangle {
        x: 4px + i * root.cell;
        y: 4px;
        width: root.cell;
        height: 30px;
        border-radius: 15px;
        background: root.index == i ? Theme.accent : transparent;
        Text {
            text: t;
            color: root.index == i ? #0e111b : Theme.text;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea { clicked => { root.picked(i); } }
    }
}

component Steps3 inherits Rectangle {
    in property <int> index;
    callback picked(int);
    height: 28px;
    Rectangle {
        x: 0px;
        y: (parent.height - 4px) / 2;
        width: parent.width;
        height: 4px;
        border-radius: 2px;
        background: Theme.surface-hi;
    }
    for i in 3: Rectangle {
        width: root.index == i ? 18px : 10px;
        height: self.width;
        border-radius: self.width / 2;
        x: i * (root.width - 18px) / 2 + (18px - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: root.index == i ? white : Theme.dim;
        border-width: root.index == i ? 3px : 0px;
        border-color: Theme.accent;
    }
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.picked(self.mouse-x < root.width / 3 ? 0 : (self.mouse-x < root.width * 2 / 3 ? 1 : 2));
            }
        }
    }
}

component EqGraph inherits Rectangle {
    property <length> lw: 48px;
    property <length> cw: (root.width - lw) / 9;
    property <int> dragging: -1;
    pure function py(db: float) -> length { return (6 - db) / 12 * root.height; }
    pure function px(i: int) -> length { return lw + (i + 0.5) * cw; }
    pure function n(v: length) -> float { return v / 1px; }
    pure function cx(i: int) -> length { return px(max(0, min(8, i))); }
    pure function cy(i: int) -> length { return py(Backend.eq[max(0, min(8, i))]); }
    pure function clampy(v: length) -> length { return max(0px, min(root.height, v)); }
    // Cubic Bezier segment from point i to i+1 (Catmull-Rom tangents).
    pure function seg(i: int) -> string {
        return "C \{n(cx(i) + (cx(i + 1) - cx(i - 1)) / 6)} \{n(clampy(cy(i) + (cy(i + 1) - cy(i - 1)) / 6))} \{n(cx(i + 1) - (cx(i + 2) - cx(i)) / 6)} \{n(clampy(cy(i + 1) - (cy(i + 2) - cy(i)) / 6))} \{n(cx(i + 1))} \{n(cy(i + 1))}";
    }
    property <string> line: "M \{n(cx(0))} \{n(cy(0))} " + seg(0) + " " + seg(1) + " " + seg(2) + " " + seg(3) + " " + seg(4) + " " + seg(5) + " " + seg(6) + " " + seg(7);

    for lab[k] in ["+6", "+3", "0", "-3", "-6"]: Text {
        x: 0px;
        y: k * root.height / 4 - 8px;
        width: lw - 12px;
        height: 16px;
        text: lab;
        color: Theme.dim;
        font-size: 11px;
        horizontal-alignment: right;
    }
    for k in 5: Rectangle {
        x: lw;
        y: k * root.height / 4;
        width: root.width - lw;
        height: 1px;
        background: k == 2 ? Theme.text.with-alpha(0.22) : Theme.text.with-alpha(0.06);
    }
    // Per band track with a fill from the zero line to the handle.
    for i in 9: Rectangle {
        x: px(i) - 2px;
        y: 0px;
        width: 4px;
        height: root.height;
        border-radius: 2px;
        background: Theme.text.with-alpha(0.05);
    }
    for i in 9: Rectangle {
        x: px(i) - 2px;
        y: min(py(0), py(Backend.eq[i]));
        width: 4px;
        height: max(1px, abs(py(Backend.eq[i]) - py(0)));
        border-radius: 2px;
        background: Theme.aurora;
        opacity: 0.55;
    }
    Path {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        fill: @linear-gradient(180deg, #6ea8ff30 0%, #b987ff00 100%);
        commands: root.line + " L \{n(cx(8))} \{n(py(0))} L \{n(cx(0))} \{n(py(0))} Z";
    }
    Path {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        stroke: Theme.accent;
        stroke-width: 2.5px;
        stroke-line-cap: round;
        commands: root.line;
    }
    for i in 9: Rectangle {
        x: px(i) - 8px;
        y: py(Backend.eq[i]) - 8px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: white;
        border-width: 3px;
        border-color: root.dragging == i ? Theme.accent2 : Theme.accent;
    }
    for i in 9: Text {
        x: px(i) - 30px;
        y: root.height + 12px;
        width: 60px;
        text: ["64", "125", "250", "500", "1k", "2k", "4k", "8k", "16k"][i];
        color: Theme.dim;
        font-size: 11px;
        horizontal-alignment: center;
    }
    for i in 9: TouchArea {
        x: lw + i * cw;
        y: 0px;
        width: cw;
        height: root.height;
        function upd() {
            Backend.eq[i] = round((6 - max(0px, min(root.height, self.mouse-y)) / root.height * 12) * 20) / 20;
            Backend.eq-moved(i, Backend.eq[i]);
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.dragging = i; self.upd(); }
            else if (e.kind == PointerEventKind.up) { root.dragging = -1; }
        }
        moved => { self.upd(); }
    }
    if root.dragging >= 0: Rectangle {
        x: px(root.dragging) - 36px;
        y: max(0px, py(Backend.eq[root.dragging]) - 44px);
        width: 72px;
        height: 24px;
        border-radius: 12px;
        background: Theme.surface-hi;
        border-width: 1px;
        border-color: Theme.edge;
        Text {
            text: (Backend.eq[root.dragging] >= 0 ? "+" : "") + round(Backend.eq[root.dragging] * 100) / 100 + " dB";
            color: white;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component OutputPage inherits Rectangle {
    Card {
        x: 32px;
        y: 8px;
        width: parent.width - 64px;
        height: 330px;
        Cap { x: 24px; y: 18px; text: "EQUALIZER"; }
        Text {
            x: parent.width - 224px;
            y: 18px;
            width: 200px;
            text: "Drag a band to shape the sound";
            color: Theme.dim;
            font-size: 11px;
            horizontal-alignment: right;
        }
        EqGraph {
            x: 24px;
            y: 60px;
            width: parent.width - 48px;
            height: 220px;
        }
    }
    Card {
        x: 32px;
        y: 352px;
        width: parent.width - 64px;
        height: 96px;
        Cap { x: 24px; y: 22px; text: "SURROUND"; }
        Text { x: 24px; y: 40px; text: "Virtual 7.1 for headphones"; color: Theme.dim; font-size: 11px; }
        Pills {
            x: 250px;
            y: 29px;
            labels: ["2.0", "7.1"];
            index: Backend.surround ? 1 : 0;
            picked(i) => { Backend.surround = i == 1; Backend.surround-set(i == 1); }
        }
        Cap {
            x: 470px;
            y: 22px;
            text: "REVERBERATION";
            opacity: Backend.surround ? 1.0 : 0.4;
        }
        Text {
            x: 470px;
            y: 40px;
            text: Backend.surround ? "Room ambience" : "Available in 7.1 mode";
            color: Theme.dim;
            font-size: 11px;
        }
        Slim {
            x: 650px;
            y: 34px;
            width: parent.width - 650px - 28px;
            enabled: Backend.surround;
            value <=> Backend.reverb;
            changed(v) => { Backend.reverb-set(v); }
        }
    }
}

component MicPage inherits Rectangle {
    Card {
        x: 32px;
        y: 8px;
        width: parent.width - 64px;
        height: 214px;
        Cap { x: 24px; y: 18px; text: "MICROPHONE LEVEL"; }
        Text {
            x: parent.width - 224px;
            y: 18px;
            width: 200px;
            text: "Live input spectrum";
            color: Theme.dim;
            font-size: 11px;
            horizontal-alignment: right;
        }
        for v[i] in Backend.spectrum: Rectangle {
            property <length> h: max(6px, min(150px, (v + 80) / 70 * 150px));
            width: 14px;
            height: self.h;
            x: 40px + i * (parent.width - 96px) / 14;
            y: 190px - self.h;
            border-radius: 5px;
            background: Theme.aurora;
            opacity: 0.9;
        }
    }
    Card {
        x: 32px;
        y: 238px;
        width: (parent.width - 64px - 48px) / 4;
        height: 150px;
        Cap { x: 20px; y: 18px; text: "VOICE ENHANCER"; }
        Dropdown {
            x: 20px;
            y: 56px;
            label: ["OFF", "WARM", "CLEAR"][Backend.voice];
            items: ["OFF", "WARM", "CLEAR"];
            menu-width: 150px;
            picked(i) => { Backend.voice = i; Backend.voice-set(i); }
        }
        Text {
            x: 20px;
            y: 104px;
            width: parent.width - 40px;
            text: "Shapes your voice tone";
            color: Theme.dim;
            font-size: 11px;
        }
    }
    Card {
        x: 32px + (parent.width - 64px - 48px) / 4 + 16px;
        y: 238px;
        width: (parent.width - 64px - 48px) / 4;
        height: 150px;
        Cap { x: 20px; y: 18px; text: "GAIN"; }
        Slim { x: 20px; y: 56px; width: parent.width - 40px; value <=> Backend.gain; changed(v) => { Backend.gain-set(v); } }
        Text { x: 20px; y: 104px; text: "Microphone input level"; color: Theme.dim; font-size: 11px; }
    }
    Card {
        x: 32px + 2 * ((parent.width - 64px - 48px) / 4 + 16px);
        y: 238px;
        width: (parent.width - 64px - 48px) / 4;
        height: 150px;
        Cap { x: 20px; y: 18px; text: "NOISE GATE"; }
        Slim { x: 20px; y: 56px; width: parent.width - 40px; value <=> Backend.gate; changed(v) => { Backend.gate-set(v); } }
        Text { x: 20px; y: 104px; text: "Mutes sound below this level"; color: Theme.dim; font-size: 11px; }
    }
    Card {
        x: 32px + 3 * ((parent.width - 64px - 48px) / 4 + 16px);
        y: 238px;
        width: (parent.width - 64px - 48px) / 4;
        height: 150px;
        Cap { x: 20px; y: 18px; text: "NOISE CANCELLATION"; }
        Steps3 {
            x: 20px;
            y: 56px;
            width: parent.width - 40px;
            index: Backend.nc;
            picked(i) => { Backend.nc = i; Backend.nc-set(i); }
        }
        Text { x: 20px; y: 104px; text: "Low, medium or high"; color: Theme.dim; font-size: 11px; }
    }
}

component SettingsPage inherits Rectangle {
    Card {
        x: 32px;
        y: 8px;
        width: 300px;
        height: 330px;
        Cap { x: 22px; y: 20px; text: "DEVICE"; }
        Text { x: 22px; y: 48px; text: "EPOS GSX 300"; color: Theme.text; font-size: 16px; font-weight: 700; }
        Rectangle {
            x: 22px;
            y: 84px;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: Backend.connected ? #38d39f : #6b7390;
        }
        Text {
            x: 40px;
            y: 80px;
            text: Backend.connected ? "Connected" : "Not connected";
            color: Backend.connected ? #38d39f : Theme.dim;
            font-size: 12px;
        }
        Cap { x: 22px; y: 130px; text: "PLAYBACK"; }
        Text { x: 22px; y: 150px; width: parent.width - 44px; text: Backend.playback-name; color: Theme.text; font-size: 12px; overflow: elide; }
        Cap { x: 22px; y: 194px; text: "RECORDING"; }
        Text { x: 22px; y: 214px; width: parent.width - 44px; text: Backend.recording-name; color: Theme.text; font-size: 12px; overflow: elide; }
        Cap { x: 22px; y: 270px; text: "VERSION"; }
        Text { x: 22px; y: 290px; text: Backend.version; color: Theme.text; font-size: 12px; }
    }
    Card {
        x: 348px;
        y: 8px;
        width: parent.width - 348px - 32px;
        height: 330px;
        Cap { x: 24px; y: 20px; text: "SMART BUTTON"; }
        Dropdown {
            x: 24px;
            y: 44px;
            label: Backend.action-names[Backend.action-index];
            items: Backend.action-names;
            menu-width: 280px;
            picked(i) => { Backend.action-index = i; Backend.action-selected(i); }
        }
        if Backend.param-visible: Rectangle {
            x: 24px;
            y: 92px;
            width: parent.width - 48px;
            height: 38px;
            border-radius: 10px;
            background: Theme.surface-hi;
            TextInput {
                x: 14px;
                width: parent.width - 28px;
                text: Backend.action-param;
                color: Theme.text;
                font-size: 12px;
                vertical-alignment: center;
                edited => { Backend.param-edited(self.text); }
            }
        }
        if Backend.param-visible: Text {
            x: 24px;
            y: 136px;
            width: parent.width - 48px;
            text: Backend.param-hint;
            color: Theme.dim;
            font-size: 11px;
            wrap: word-wrap;
        }
        Cap { x: 24px; y: 200px; text: "KNOB LIGHT"; }
        for name[i] in ["OFF", "RED", "BLUE", "PURPLE"]: Rectangle {
            x: 24px + i * 104px;
            y: 226px;
            width: 96px;
            height: 38px;
            border-radius: 19px;
            background: Backend.led-index == i ? Theme.accent.with-alpha(0.18) : Theme.surface-hi;
            border-width: 1px;
            border-color: Backend.led-index == i ? Theme.accent : Theme.edge;
            Rectangle {
                x: 14px;
                y: (parent.height - 12px) / 2;
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: [#00000000, #ef5350, #42a5f5, #ab47bc][i];
                border-width: 1px;
                border-color: Theme.dim;
            }
            Text { x: 34px; text: name; color: Theme.text; font-size: 11px; font-weight: 700; vertical-alignment: center; }
            TouchArea { clicked => { Backend.led-index = i; Backend.led-selected(i); } }
        }
    }
    Card {
        x: 32px;
        y: 352px;
        width: parent.width - 64px;
        height: 80px;
        Text { x: 24px; y: 18px; text: "Launch at startup"; color: Theme.text; font-size: 14px; font-weight: 700; }
        Text { x: 24px; y: 42px; text: "Start silently in the system tray when you sign in"; color: Theme.dim; font-size: 11px; }
        Toggle {
            x: parent.width - 74px;
            y: 26px;
            on <=> Backend.autostart;
            toggled(v) => { Backend.autostart-toggled(v); }
        }
    }
}

export component MainWindow inherits Window {
    no-frame: true;
    width: 1040px;
    height: 590px;
    title: "EposControl";
    background: #0e111b;
    property <int> page: 0;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: Theme.backdrop;
    }

    Timer {
        interval: 60ms;
        running: root.page == 1;
        triggered => { Backend.poll-spectrum(); }
    }

    // Title bar
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 64px;
        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    Backend.drag-window();
                }
            }
        }
        Rectangle {
            x: 28px;
            y: 14px;
            width: 36px;
            height: 36px;
            border-radius: 11px;
            background: Theme.aurora;
            Image {
                x: 7px;
                y: 7px;
                width: 22px;
                height: 22px;
                source: @image-url("../../../assets/icons/headset_mic.svg");
                colorize: #0e111b;
            }
        }
        Text {
            x: 76px;
            y: 20px;
            text: "EposControl";
            color: Theme.text;
            font-size: 18px;
            font-weight: 700;
        }
        HorizontalLayout {
            x: 0px;
            width: parent.width - 24px;
            y: 14px;
            height: 36px;
            spacing: 10px;
            alignment: end;
            if root.page != 2: Dropdown {
                label: Backend.preset-label;
                items: Backend.preset-names;
                menu-width: 170px;
                picked(i) => { Backend.preset-selected(i); }
            }
            if root.page == 0: IconBtn {
                icon: @image-url("../../../assets/icons/add_box.svg");
                tint: Theme.accent;
                clicked => { Backend.preset-add(); }
            }
            Dropdown {
                label: "VOLUME";
                items: [];
                opened() => { Backend.refresh-volume(); vol.show(); }
            }
            IconBtn {
                icon: @image-url("../../../assets/icons/remove.svg");
                glyph: 18px;
                clicked => { Backend.minimize(); }
            }
            IconBtn {
                icon: @image-url("../../../assets/icons/close.svg");
                glyph: 18px;
                clicked => { Backend.close(); }
            }
        }
    }
    vol := PopupWindow {
        x: root.width - 260px;
        y: 58px;
        width: 230px;
        height: 60px;
        Rectangle {
            background: Theme.surface-hi;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.edge;
            Slim {
                x: 18px;
                y: 16px;
                width: parent.width - 36px;
                value <=> Backend.volume;
                changed(v) => { Backend.volume-set(v); }
            }
        }
    }

    // Pages
    if root.page == 0: OutputPage { x: 0px; y: 64px; width: parent.width; height: 456px; }
    if root.page == 1: MicPage { x: 0px; y: 64px; width: parent.width; height: 456px; }
    if root.page == 2: SettingsPage { x: 0px; y: 64px; width: parent.width; height: 456px; }

    // Bottom navigation
    Rectangle {
        x: 0px;
        y: 528px;
        width: parent.width;
        height: 62px;
        HorizontalLayout {
            alignment: center;
            spacing: 14px;
            for ic[i] in [
                { icon: @image-url("../../../assets/icons/headphones.svg"), name: "Output" },
                { icon: @image-url("../../../assets/icons/record_voice_over.svg"), name: "Microphone" },
                { icon: @image-url("../../../assets/icons/settings.svg"), name: "Settings" }
            ]: Rectangle {
                y: 8px;
                width: 150px;
                height: 44px;
                border-radius: 22px;
                background: root.page == i ? Theme.accent.with-alpha(0.16) : (nav.has-hover ? Theme.text.with-alpha(0.06) : transparent);
                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    Image {
                        source: ic.icon;
                        width: 22px;
                        height: 22px;
                        y: (parent.height - self.height) / 2;
                        colorize: root.page == i ? Theme.accent : Theme.dim;
                    }
                    Text {
                        text: ic.name;
                        color: root.page == i ? Theme.text : Theme.dim;
                        font-size: 13px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                nav := TouchArea { clicked => { root.page = i; Backend.page-changed(i); } }
            }
        }
    }
}
