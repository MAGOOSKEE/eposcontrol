import { Switch, Palette } from "std-widgets.slint";

component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 44px;
    border-radius: 22px;
    background: root.active ? Palette.accent-background.with-alpha(0.20)
        : area.has-hover ? Palette.foreground.with-alpha(0.07) : transparent;
    HorizontalLayout {
        padding-left: 16px;
        spacing: 14px;
        alignment: start;
        Image {
            source: root.icon;
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            colorize: Palette.foreground;
        }
        Text {
            text: root.label;
            color: Palette.foreground;
            font-size: 14px;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
        }
    }
    area := TouchArea { clicked => { root.clicked(); } }
}

component Row inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    height: 68px;
    border-radius: 12px;
    background: Palette.alternate-background;
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: root.title; color: Palette.foreground; font-size: 15px; }
            Text { text: root.subtitle; color: Palette.foreground.with-alpha(0.65); font-size: 12px; }
        }
        @children
    }
}

export component MainWindow inherits Window {
    title: "EposControl";
    min-width: 640px;
    min-height: 420px;
    preferred-width: 820px;
    preferred-height: 540px;
    background: Palette.background;

    in property <bool> connected;
    in-out property <bool> surround;
    in-out property <bool> autostart;
    callback surround-toggled(bool);
    callback autostart-toggled(bool);
    property <int> page: 0;

    HorizontalLayout {
        Rectangle {
            width: 230px;
            background: Palette.alternate-background;
            VerticalLayout {
                padding: 16px;
                spacing: 6px;
                alignment: start;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-bottom: 18px;
                    spacing: 12px;
                    Image {
                        source: @image-url("../../../assets/icons/headset_mic.svg");
                        width: 28px;
                        height: 28px;
                        colorize: Palette.accent-background;
                    }
                    Text {
                        text: "EposControl";
                        font-size: 18px;
                        font-weight: 700;
                        color: Palette.foreground;
                        vertical-alignment: center;
                    }
                }
                NavItem {
                    icon: @image-url("../../../assets/icons/usb.svg");
                    label: "Device";
                    active: root.page == 0;
                    clicked => { root.page = 0; }
                }
                NavItem {
                    icon: @image-url("../../../assets/icons/settings.svg");
                    label: "Settings";
                    active: root.page == 1;
                    clicked => { root.page = 1; }
                }
            }
        }

        VerticalLayout {
            padding: 32px;
            spacing: 14px;
            alignment: start;

            if root.page == 0: VerticalLayout {
                spacing: 14px;
                Text { text: "Device"; font-size: 26px; font-weight: 700; color: Palette.foreground; }
                Row {
                    title: "EPOS GSX 300";
                    subtitle: root.connected ? "Connected" : "Not connected";
                    Rectangle {
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        y: (parent.height - self.height) / 2;
                        background: root.connected ? #2e9e5b : #9aa0a6;
                    }
                }
                Row {
                    title: "Smart button: Surround";
                    subtitle: "Press the button on the device or use this switch";
                    Switch {
                        checked <=> root.surround;
                        enabled: root.connected;
                        toggled => { root.surround-toggled(self.checked); }
                    }
                }
            }

            if root.page == 1: VerticalLayout {
                spacing: 14px;
                Text { text: "Settings"; font-size: 26px; font-weight: 700; color: Palette.foreground; }
                Row {
                    title: "Launch at startup";
                    subtitle: "Start silently in the system tray when you sign in";
                    Switch {
                        checked <=> root.autostart;
                        toggled => { root.autostart-toggled(self.checked); }
                    }
                }
            }
        }
    }
}
