// EposControl main window.
// Nav rail on the left, page content on the right. Pages: Home, Headphones,
// Microphone, Settings. The single accent colour mirrors the knob light.

export struct Profile {
    name: string,
    custom: bool,
}

export global Backend {
    in-out property <[float]> eq: [0, 0, 0, 0, 0, 0, 0, 0, 0];
    in-out property <[float]> mic-eq: [0, 0, 0, 0, 0, 0, 0, 0, 0];
    in property <string> preset-label: "FLAT";
    in property <[Profile]> preset-items;
    in property <string> mic-preset-label: "FLAT";
    in property <[Profile]> mic-preset-items;
    in-out property <bool> surround;
    in-out property <float> reverb;
    in-out property <float> gain;
    in-out property <float> sidetone;
    in-out property <float> gate;
    in-out property <int> nc;
    in-out property <float> volume;
    in property <bool> mic-muted;
    in property <bool> window-visible: true;
    in property <bool> audio-supported: true;
    in property <[float]> wave: [0, 0, 0, 0];
    in property <bool> connected;
    in property <string> version;
    in property <string> serial;
    in property <string> official-issue;
    in property <bool> official-busy;
    in property <color> knob-color: #3b8cff;
    in-out property <int> led-mode;
    in-out property <int> button-index;
    in property <[string]> button-names;
    in-out property <bool> autostart;
    in-out property <bool> notifications: true;
    in property <bool> test-playing;
    in property <float> test-progress;
    in property <string> test-time: "00:00";
    in property <int> mic-test-state;
    in property <float> mic-test-progress;
    in property <string> mic-test-time: "00:00";

    callback eq-moved(int, float);
    callback mic-eq-moved(int, float);
    callback preset-selected(int);
    callback preset-add(string);
    callback preset-deleted(int);
    callback mic-preset-selected(int);
    callback mic-preset-add(string);
    callback mic-preset-deleted(int);
    callback surround-set(bool);
    callback reverb-set(float);
    callback gain-set(float);
    callback sidetone-set(float);
    callback gate-set(float);
    callback nc-set(int);
    callback volume-set(float);
    callback refresh-volume();
    callback toggle-mute();
    callback button-pressed();
    callback official-disable();
    callback poll-wave();
    callback page-changed(int);
    callback led-mode-selected(int);
    callback button-selected(int);
    callback autostart-toggled(bool);
    callback notifications-toggled(bool);
    callback test-toggle();
    callback mic-test-record();
    callback mic-test-play();
    callback mic-test-stop();
    callback drag-window();
    callback minimize();
    callback close();
}

global Theme {
    out property <color> bg: #0f1013;
    out property <color> rail: #0b0c0e;
    out property <color> field: #181a1f;
    out property <color> field-hi: #22252c;
    out property <color> rule: #2a2e36;
    out property <color> text: #eceef1;
    out property <color> dim: #8a909b;
    out property <color> accent: Backend.knob-color;
    out property <color> accent-ink: #0b0c0e;
    out property <color> danger: #ff5a52;
    out property <length> r-sm: 6px;
    out property <length> r-md: 8px;
    out property <length> r-lg: 12px;
    out property <string> body: "Segoe UI";
    out property <string> label: "Segoe UI";
    out property <string> mono: "Consolas";
}

component Label inherits Text {
    color: Theme.dim;
    font-family: Theme.label;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.2px;
}

component Mono inherits Text {
    color: Theme.text;
    font-family: Theme.mono;
    font-size: 13px;
}

component Rule inherits Rectangle {
    height: 1px;
    background: Theme.rule;
}

// Caption on top, control placed by the caller below it.
component Field inherits Rectangle {
    in property <string> label;
    height: 62px;
    Label { x: 0px; y: 0px; text: root.label; }
}

component Btn inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked;
    height: 34px;
    width: max(36px, row.preferred-width + 28px);
    border-radius: Theme.r-md;
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.rule;
    background: area.has-hover && root.enabled ? Theme.field-hi : Theme.field;
    opacity: root.enabled ? 1.0 : 0.4;
    row := HorizontalLayout {
        x: 0px;
        y: 0px;
        alignment: center;
        spacing: 8px;
        padding-left: 4px;
        padding-right: 4px;
        if root.icon.width > 0: Image {
            source: root.icon;
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            colorize: root.active ? Theme.accent : Theme.text;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.active ? Theme.accent : Theme.text;
            font-family: Theme.label;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.6px;
            vertical-alignment: center;
        }
    }
    area := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component Select inherits Rectangle {
    in property <string> label;
    in property <[string]> items;
    in property <length> menu-width: 180px;
    callback picked(int);
    height: 34px;
    border-radius: Theme.r-md;
    border-width: 1px;
    border-color: Theme.rule;
    background: area.has-hover ? Theme.field-hi : Theme.field;
    Text {
        x: 14px;
        y: 0px;
        width: parent.width - 40px;
        height: parent.height;
        text: root.label;
        color: Theme.text;
        font-family: Theme.label;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.6px;
        vertical-alignment: center;
        overflow: elide;
    }
    Image {
        x: parent.width - 26px;
        y: (parent.height - self.height) / 2;
        width: 20px;
        height: 20px;
        source: @image-url("../../../assets/icons/arrow_drop_down.svg");
        colorize: Theme.dim;
    }
    area := TouchArea { clicked => { pop.show(); } }
    pop := PopupWindow {
        x: root.width - root.menu-width;
        y: root.height + 4px;
        width: root.menu-width;
        Rectangle {
            background: Theme.field-hi;
            border-radius: Theme.r-md;
            border-width: 1px;
            border-color: Theme.rule;
            VerticalLayout {
                padding: 4px;
                for item[i] in root.items: Rectangle {
                    height: 32px;
                    border-radius: Theme.r-sm;
                    background: ia.has-hover ? Theme.accent.with-alpha(0.22) : transparent;
                    Text {
                        x: 12px;
                        y: 0px;
                        width: parent.width - 24px;
                        height: parent.height;
                        text: item;
                        color: Theme.text;
                        font-family: Theme.label;
                        font-size: 12px;
                        font-weight: 600;
                        letter-spacing: 0.6px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    ia := TouchArea { clicked => { root.picked(i); } }
                }
            }
        }
    }
}

// Profile picker. Custom profiles get an X to delete them.
component ProfileSelect inherits Rectangle {
    in property <string> label;
    in property <[Profile]> items;
    in property <length> menu-width: 200px;
    callback picked(int);
    callback deleted(int);
    height: 34px;
    border-radius: Theme.r-md;
    border-width: 1px;
    border-color: Theme.rule;
    background: area.has-hover ? Theme.field-hi : Theme.field;
    Text {
        x: 14px;
        y: 0px;
        width: parent.width - 40px;
        height: parent.height;
        text: root.label;
        color: Theme.text;
        font-family: Theme.label;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.6px;
        vertical-alignment: center;
        overflow: elide;
    }
    Image {
        x: parent.width - 26px;
        y: (parent.height - self.height) / 2;
        width: 20px;
        height: 20px;
        source: @image-url("../../../assets/icons/arrow_drop_down.svg");
        colorize: Theme.dim;
    }
    area := TouchArea { clicked => { pop.show(); } }
    pop := PopupWindow {
        x: root.width - root.menu-width;
        y: root.height + 4px;
        width: root.menu-width;
        Rectangle {
            background: Theme.field-hi;
            border-radius: Theme.r-md;
            border-width: 1px;
            border-color: Theme.rule;
            VerticalLayout {
                padding: 4px;
                for item[i] in root.items: Rectangle {
                    height: 32px;
                    border-radius: Theme.r-sm;
                    background: ia.has-hover ? Theme.accent.with-alpha(0.22) : transparent;
                    ia := TouchArea { clicked => { root.picked(i); } }
                    Text {
                        x: 12px;
                        y: 0px;
                        width: parent.width - (item.custom ? 52px : 24px);
                        height: parent.height;
                        text: item.name;
                        color: Theme.text;
                        font-family: Theme.label;
                        font-size: 12px;
                        font-weight: 600;
                        letter-spacing: 0.6px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if item.custom: Rectangle {
                        x: parent.width - 30px;
                        y: 2px;
                        width: 28px;
                        height: 28px;
                        border-radius: Theme.r-sm;
                        background: xa.has-hover ? Theme.danger.with-alpha(0.28) : transparent;
                        Image {
                            x: 7px;
                            y: 7px;
                            width: 14px;
                            height: 14px;
                            source: @image-url("../../../assets/icons/close.svg");
                            colorize: xa.has-hover ? Theme.danger : Theme.dim;
                        }
                        xa := TouchArea { clicked => { root.deleted(i); } }
                    }
                }
            }
        }
    }
}

component Seg inherits Rectangle {
    in property <[string]> labels;
    in property <int> index;
    in property <length> cell: 64px;
    callback picked(int);
    height: 36px;
    width: root.labels.length * root.cell + 6px;
    border-radius: Theme.r-md;
    border-width: 1px;
    border-color: Theme.rule;
    background: Theme.field;
    for t[i] in root.labels: Rectangle {
        x: 3px + i * root.cell;
        y: 3px;
        width: root.cell;
        height: parent.height - 6px;
        border-radius: Theme.r-sm;
        background: root.index == i ? Theme.accent : (sa.has-hover ? Theme.field-hi : transparent);
        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: t;
            color: root.index == i ? Theme.accent-ink : Theme.text;
            font-family: Theme.label;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.6px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        sa := TouchArea { clicked => { root.picked(i); } }
    }
}

component Slim inherits Rectangle {
    in-out property <float> value;
    in property <bool> enabled: true;
    callback changed(float);
    height: 28px;
    opacity: root.enabled ? 1.0 : 0.35;
    Rectangle {
        x: 0px;
        y: (parent.height - 4px) / 2;
        width: parent.width;
        height: 4px;
        border-radius: 2px;
        background: Theme.rule;
    }
    Rectangle {
        x: 0px;
        y: (parent.height - 4px) / 2;
        width: root.value * (parent.width - 10px) + 5px;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
    }
    Rectangle {
        x: root.value * (parent.width - 10px);
        y: (parent.height - 18px) / 2;
        width: 10px;
        height: 18px;
        border-radius: 5px;
        background: Theme.text;
    }
    TouchArea {
        enabled: root.enabled;
        function upd() {
            root.value = max(0.0, min(1.0, (self.mouse-x - 5px) / (self.width - 10px)));
            root.changed(root.value);
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { self.upd(); }
        }
        moved => { self.upd(); }
    }
}

// Three stop selector with captions: off, low, high.
component Steps3 inherits Rectangle {
    in property <int> index;
    in property <[string]> labels: ["OFF", "LOW", "HIGH"];
    callback picked(int);
    height: 46px;
    Rectangle {
        x: 0px;
        y: 12px;
        width: parent.width;
        height: 4px;
        border-radius: 2px;
        background: Theme.rule;
    }
    Rectangle {
        x: 0px;
        y: 12px;
        width: root.index * (parent.width - 12px) / 2 + 6px;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
    }
    for i in 3: Rectangle {
        x: i * (root.width - 12px) / 2;
        y: 8px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: root.index >= i ? Theme.accent : Theme.field-hi;
        border-width: 2px;
        border-color: root.index >= i ? Theme.accent : Theme.dim;
    }
    for t[i] in root.labels: Text {
        x: i * (root.width - 12px) / 2 - 20px + 6px;
        y: 28px;
        width: 40px;
        text: t;
        color: root.index == i ? Theme.text : Theme.dim;
        font-family: Theme.label;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.8px;
        horizontal-alignment: center;
    }
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.picked(self.mouse-x < root.width / 3 ? 0 : (self.mouse-x < root.width * 2 / 3 ? 1 : 2));
            }
        }
    }
}

// One labelled row of a settings list: label on the left, control on the right.
component Row inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    height: 56px;
    Rule { x: 0px; y: parent.height - 1px; width: parent.width; }
    Text {
        x: 0px;
        y: root.hint == "" ? (parent.height - self.height) / 2 : 10px;
        text: root.label;
        color: Theme.text;
        font-family: Theme.body;
        font-size: 14px;
        font-weight: 600;
    }
    if root.hint != "": Text {
        x: 0px;
        y: 31px;
        text: root.hint;
        color: Theme.dim;
        font-family: Theme.body;
        font-size: 11px;
    }
}

// Nine band equaliser with Bezier smoothed curve. Used for headphones and microphone.
component EqGraph inherits Rectangle {
    in-out property <[float]> values;
    callback moved(int, float);
    property <length> lw: 44px;
    property <length> cw: (root.width - lw) / 9;
    property <int> dragging: -1;
    pure function py(db: float) -> length { return (6 - db) / 12 * root.height; }
    pure function px(i: int) -> length { return lw + (i + 0.5) * cw; }
    pure function n(v: length) -> float { return v / 1px; }
    pure function cx(i: int) -> length { return px(max(0, min(8, i))); }
    pure function cy(i: int) -> length { return py(root.values[max(0, min(8, i))]); }
    pure function clampy(v: length) -> length { return max(0px, min(root.height, v)); }
    // Cubic Bezier segment from point i to i+1 using Catmull-Rom tangents.
    pure function seg(i: int) -> string {
        return "C \{n(cx(i) + (cx(i + 1) - cx(i - 1)) / 6)} \{n(clampy(cy(i) + (cy(i + 1) - cy(i - 1)) / 6))} \{n(cx(i + 1) - (cx(i + 2) - cx(i)) / 6)} \{n(clampy(cy(i + 1) - (cy(i + 2) - cy(i)) / 6))} \{n(cx(i + 1))} \{n(cy(i + 1))}";
    }
    property <string> line: "M \{n(cx(0))} \{n(cy(0))} " + seg(0) + " " + seg(1) + " " + seg(2) + " " + seg(3) + " " + seg(4) + " " + seg(5) + " " + seg(6) + " " + seg(7);

    for lab[k] in ["+6", "+3", "0", "-3", "-6"]: Mono {
        x: 0px;
        y: k * root.height / 4 - 8px;
        width: lw - 10px;
        height: 16px;
        text: lab;
        color: Theme.dim;
        font-size: 11px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    for k in 5: Rectangle {
        x: lw;
        y: k * root.height / 4;
        width: root.width - lw;
        height: 1px;
        background: k == 2 ? Theme.dim.with-alpha(0.55) : Theme.rule;
    }
    for i in 9: Rectangle {
        x: px(i);
        y: 0px;
        width: 1px;
        height: root.height;
        background: Theme.rule;
    }
    Path {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        stroke: Theme.accent;
        stroke-width: 2px;
        commands: root.line;
    }
    for i in 9: Rectangle {
        x: px(i) - 6px;
        y: py(root.values[i]) - 6px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: root.dragging == i ? Theme.accent : Theme.bg;
        border-width: 2px;
        border-color: Theme.accent;
    }
    for i in 9: Text {
        x: px(i) - 30px;
        y: root.height + 12px;
        width: 60px;
        text: ["64", "125", "250", "500", "1k", "2k", "4k", "8k", "16k"][i];
        color: Theme.text;
        font-family: Theme.label;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
    }
    for i in 9: Mono {
        x: px(i) - 30px;
        y: root.height + 32px;
        width: 60px;
        text: (root.values[i] >= 0 ? "+" : "") + round(root.values[i] * 10) / 10;
        color: root.dragging == i ? Theme.accent : Theme.dim;
        font-size: 12px;
        horizontal-alignment: center;
    }
    for i in 9: TouchArea {
        x: lw + i * cw;
        y: 0px;
        width: cw;
        height: root.height;
        function upd(snap: bool) {
            // Hold Ctrl to snap to 0.5 dB steps, otherwise 0.05 dB.
            root.values[i] = snap
                ? round((6 - max(0px, min(root.height, self.mouse-y)) / root.height * 12) * 2) / 2
                : round((6 - max(0px, min(root.height, self.mouse-y)) / root.height * 12) * 20) / 20;
            root.moved(i, root.values[i]);
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.dragging = i; self.upd(e.modifiers.control); }
            else if (e.kind == PointerEventKind.move && self.pressed) { self.upd(e.modifiers.control); }
            else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { root.dragging = -1; }
        }
    }
}

// Scrolling input level (mirrored envelope) with the noise gate drawn as a pair of lines.
component WaveView inherits Rectangle {
    in property <[float]> samples;
    in property <float> gate;
    property <length> mid: root.height / 2;
    property <length> reach: root.height / 2 - 6px;
    height: 130px;
    border-radius: Theme.r-md;
    border-width: 1px;
    border-color: Theme.rule;
    background: Theme.field;
    clip: true;
    Rectangle { x: 0px; y: root.mid; width: root.width; height: 1px; background: Theme.rule; }
    for v[i] in root.samples: Rectangle {
        property <length> half: max(1px, v * root.reach);
        x: 6px + i * (root.width - 12px) / 160;
        y: root.mid - self.half;
        width: max(1px, (root.width - 12px) / 160 - 1px);
        height: self.half * 2;
        background: v >= root.gate ? Theme.accent : Theme.dim.with-alpha(0.5);
    }
    Rectangle { x: 0px; y: root.mid - root.gate * root.reach; width: root.width; height: 1px; background: Theme.text.with-alpha(0.85); }
    Rectangle { x: 0px; y: root.mid + root.gate * root.reach; width: root.width; height: 1px; background: Theme.text.with-alpha(0.85); }
    Text {
        x: root.width - self.preferred-width - 8px;
        y: root.mid - root.gate * root.reach - 18px;
        text: "GATE";
        color: Theme.text;
        font-family: Theme.label;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 1px;
    }
}

// Device picture with the knob ring and halo in the accent colour.
component GsxArt inherits Rectangle {
    in property <length> art-w: 480px;
    width: root.art-w;
    height: root.art-w / 1.875;
    Rectangle {
        x: root.width * 0.7372 - root.width * 0.33;
        y: root.height * 0.4926 - root.width * 0.33;
        width: root.width * 0.66;
        height: root.width * 0.66;
        border-radius: root.width * 0.33;
        background: @radial-gradient(circle, Theme.accent.with-alpha(0.50) 0%, Theme.accent.with-alpha(0.0) 70%);
    }
    Image {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        source: @image-url("../../../assets/gsx300-top.svg");
    }
    Rectangle {
        x: root.width * (0.7372 - 0.1758);
        y: root.height * 0.4926 - root.width * 0.1758;
        width: root.width * 0.3516;
        height: root.width * 0.3516;
        border-radius: root.width * 0.1758;
        border-width: 3px;
        border-color: Theme.accent;
    }
}

component HomePage inherits Rectangle {
    GsxArt { x: 32px; y: 52px; art-w: 520px; }
    if Backend.official-issue != "": Rectangle {
        x: 32px;
        y: 2px;
        width: 560px;
        height: 40px;
        border-radius: Theme.r-md;
        background: Theme.accent.with-alpha(0.14);
        border-width: 1px;
        border-color: Theme.accent.with-alpha(0.55);
        Text {
            x: 14px;
            y: 0px;
            width: parent.width - 140px;
            height: parent.height;
            text: Backend.official-issue;
            color: Theme.text;
            font-family: Theme.body;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
        Btn {
            x: parent.width - 116px;
            y: 3px;
            width: 106px;
            height: 34px;
            text: Backend.official-busy ? "WORKING" : "DISABLE";
            enabled: !Backend.official-busy;
            clicked => { Backend.official-disable(); }
        }
    }
    Label { x: 32px; y: 344px; text: "STATUS"; }
    Text { x: 32px; y: 362px; text: Backend.connected ? "Connected" : "Not connected"; color: Backend.connected ? Theme.accent : Theme.dim; font-family: Theme.body; font-size: 15px; font-weight: 600; }
    Label { x: 220px; y: 344px; text: "SERIAL"; }
    Mono { x: 220px; y: 362px; text: Backend.serial; }
    Label { x: 410px; y: 344px; text: "VERSION"; }
    Mono { x: 410px; y: 362px; text: Backend.version; }

    Image {
        x: 620px + (292px - 118px) / 2;
        y: 24px;
        width: 118px;
        height: 174px;
        source: @image-url("../../../assets/gsp600.svg");
    }
    Field {
        x: 620px;
        y: 214px;
        width: 292px;
        label: "AUDIO MODE";
        Seg {
            x: 0px;
            y: 24px;
            cell: 80px;
            labels: ["2.0", "7.1"];
            index: Backend.surround ? 1 : 0;
            picked(i) => { Backend.surround-set(i == 1); }
        }
    }
    Field {
        x: 620px;
        y: 288px;
        width: 292px;
        label: "AUDIO PROFILE";
        ProfileSelect {
            x: 0px;
            y: 24px;
            width: 292px;
            label: Backend.preset-label;
            items: Backend.preset-items;
            menu-width: 292px;
            picked(i) => { Backend.preset-selected(i); }
            deleted(i) => { Backend.preset-deleted(i); }
        }
    }
    Field {
        x: 620px;
        y: 362px;
        width: 292px;
        label: "MICROPHONE";
        Btn {
            x: 0px;
            y: 24px;
            width: 292px;
            icon: Backend.mic-muted ? @image-url("../../../assets/icons/mic_off.svg") : @image-url("../../../assets/icons/mic.svg");
            text: Backend.mic-muted ? "MUTED" : "LIVE";
            active: Backend.mic-muted;
            clicked => { Backend.toggle-mute(); }
        }
    }
    Field {
        x: 620px;
        y: 436px;
        width: 292px;
        label: "VOLUME";
        Slim {
            x: 0px;
            y: 27px;
            width: 236px;
            value <=> Backend.volume;
            changed(v) => { Backend.volume-set(v); }
        }
        Mono { x: 248px; y: 27px; width: 44px; height: 28px; text: round(Backend.volume * 100) + "%"; horizontal-alignment: right; vertical-alignment: center; }
    }
}

component HeadphonesPage inherits Rectangle {
    Label { x: 32px; y: 22px; text: "HEADPHONE EQUALIZER"; }
    Text { x: parent.width - 32px - 560px; y: 20px; width: 560px; text: Backend.audio-supported ? "Hold Ctrl to snap to 0.5 dB" : "Audio effects need the EPOS Windows audio driver and are not available on this system"; color: Theme.dim; font-family: Theme.body; font-size: 11px; horizontal-alignment: right; }
    EqGraph {
        x: 32px;
        y: 56px;
        width: parent.width - 64px;
        height: 170px;
        values <=> Backend.eq;
        moved(i, v) => { Backend.eq-moved(i, v); }
    }
    Rule { x: 32px; y: 296px; width: parent.width - 64px; }

    Field {
        x: 32px;
        y: 324px;
        width: 180px;
        label: "AUDIO MODE";
        Seg {
            x: 0px;
            y: 24px;
            cell: 70px;
            labels: ["2.0", "7.1"];
            index: Backend.surround ? 1 : 0;
            picked(i) => { Backend.surround-set(i == 1); }
        }
    }
    Field {
        x: 250px;
        y: 324px;
        width: 300px;
        label: "REVERBERATION";
        opacity: Backend.surround ? 1.0 : 0.45;
        Slim {
            x: 0px;
            y: 27px;
            width: 236px;
            enabled: Backend.surround;
            value <=> Backend.reverb;
            changed(v) => { Backend.reverb-set(v); }
        }
        Mono { x: 248px; y: 27px; width: 44px; height: 28px; text: round(Backend.reverb * 100) + "%"; horizontal-alignment: right; vertical-alignment: center; }
    }
    Field {
        x: 620px;
        y: 324px;
        width: 292px;
        label: "SOUND TEST";
        Btn {
            x: 0px;
            y: 24px;
            width: 112px;
            icon: Backend.test-playing ? @image-url("../../../assets/icons/stop.svg") : @image-url("../../../assets/icons/play_arrow.svg");
            text: Backend.test-playing ? "STOP" : "PLAY";
            active: Backend.test-playing;
            clicked => { Backend.test-toggle(); }
        }
        Mono { x: 128px; y: 24px; height: 34px; text: Backend.test-time; vertical-alignment: center; }
        Rectangle {
            x: 0px;
            y: 68px;
            width: 292px;
            height: 4px;
            border-radius: 2px;
            background: Theme.rule;
            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width * max(0.0, min(1.0, Backend.test-progress));
                height: parent.height;
                border-radius: 2px;
                background: Theme.accent;
            }
        }
    }
}

component MicPage inherits Rectangle {
    Label { x: 32px; y: 22px; text: "MICROPHONE EQUALIZER"; }
    Text { x: parent.width - 32px - 560px; y: 20px; width: 560px; text: Backend.audio-supported ? "Hold Ctrl to snap to 0.5 dB" : "Audio effects need the EPOS Windows audio driver and are not available on this system"; color: Theme.dim; font-family: Theme.body; font-size: 11px; horizontal-alignment: right; }
    EqGraph {
        x: 32px;
        y: 56px;
        width: parent.width - 64px;
        height: 170px;
        values <=> Backend.mic-eq;
        moved(i, v) => { Backend.mic-eq-moved(i, v); }
    }
    Rule { x: 32px; y: 290px; width: parent.width - 64px; }

    Label { x: 32px; y: 308px; text: "INPUT LEVEL"; }
    Text { x: 32px; y: 326px; width: 450px; text: "Speak normally, then set the gate just above the background noise."; color: Theme.dim; font-family: Theme.body; font-size: 11px; }
    WaveView {
        x: 32px;
        y: 352px;
        width: 450px;
        height: 130px;
        samples: Backend.wave;
        gate: Backend.gate;
    }

    Field {
        x: 522px;
        y: 308px;
        width: 190px;
        label: "SIDE TONE";
        Slim { x: 0px; y: 27px; width: 136px; value <=> Backend.sidetone; changed(v) => { Backend.sidetone-set(v); } }
        Mono { x: 142px; y: 27px; width: 48px; height: 28px; text: Backend.sidetone <= 0.001 ? "OFF" : round(-57 + 57 * Backend.sidetone) + ""; horizontal-alignment: right; vertical-alignment: center; }
    }
    Field {
        x: 724px;
        y: 308px;
        width: 188px;
        label: "GAIN";
        Slim { x: 0px; y: 27px; width: 136px; value <=> Backend.gain; changed(v) => { Backend.gain-set(v); } }
        Mono { x: 142px; y: 27px; width: 46px; height: 28px; text: round(Backend.gain * 100) + "%"; horizontal-alignment: right; vertical-alignment: center; }
    }
    Field {
        x: 522px;
        y: 382px;
        width: 190px;
        label: "NOISE GATE";
        Slim { x: 0px; y: 27px; width: 136px; value <=> Backend.gate; changed(v) => { Backend.gate-set(v); } }
        Mono { x: 142px; y: 27px; width: 48px; height: 28px; text: round(Backend.gate * 100) + "%"; horizontal-alignment: right; vertical-alignment: center; }
    }
    Field {
        x: 724px;
        y: 382px;
        width: 188px;
        label: "NOISE CANCELLATION";
        Steps3 {
            x: 4px;
            y: 27px;
            width: 170px;
            index: Backend.nc;
            picked(i) => { Backend.nc = i; Backend.nc-set(i); }
        }
    }
    Field {
        x: 522px;
        y: 456px;
        width: 390px;
        label: "MIC TEST";
        Btn {
            x: 0px;
            y: 24px;
            width: 120px;
            icon: Backend.mic-test-state == 1 ? @image-url("../../../assets/icons/stop.svg") : @image-url("../../../assets/icons/fiber_manual_record.svg");
            text: Backend.mic-test-state == 1 ? "STOP" : "RECORD";
            active: Backend.mic-test-state == 1;
            enabled: Backend.mic-test-state != 3;
            clicked => { if (Backend.mic-test-state == 1) { Backend.mic-test-stop(); } else { Backend.mic-test-record(); } }
        }
        Btn {
            x: 130px;
            y: 24px;
            width: 100px;
            icon: Backend.mic-test-state == 3 ? @image-url("../../../assets/icons/stop.svg") : @image-url("../../../assets/icons/play_arrow.svg");
            text: Backend.mic-test-state == 3 ? "STOP" : "PLAY";
            active: Backend.mic-test-state == 3;
            enabled: Backend.mic-test-state == 2 || Backend.mic-test-state == 3;
            clicked => { if (Backend.mic-test-state == 3) { Backend.mic-test-stop(); } else { Backend.mic-test-play(); } }
        }
        Mono { x: 246px; y: 24px; height: 34px; text: Backend.mic-test-time; vertical-alignment: center; }
        Rectangle {
            x: 0px;
            y: 66px;
            width: 390px;
            height: 4px;
            border-radius: 2px;
            background: Theme.rule;
            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width * max(0.0, min(1.0, Backend.mic-test-progress));
                height: parent.height;
                border-radius: 2px;
                background: Theme.accent;
            }
        }
    }
}

component SettingsPage inherits Rectangle {
    property <length> cw: 560px;
    property <length> cx: (root.width - self.cw) / 2;
    Label { x: root.cx; y: 22px; text: "SETTINGS"; }
    Row {
        x: root.cx;
        y: 56px;
        width: root.cw;
        label: "Smart button";
        hint: "What the button on the device does";
        Select {
            x: parent.width - 220px;
            y: 11px;
            width: 220px;
            label: Backend.button-names[Backend.button-index];
            items: Backend.button-names;
            menu-width: 220px;
            picked(i) => { Backend.button-index = i; Backend.button-selected(i); }
        }
    }
    Row {
        x: root.cx;
        y: 112px;
        width: root.cw;
        label: "Knob light";
        hint: "Auto is blue in 2.0 and red in 7.1";
        Seg {
            x: parent.width - 306px;
            y: 10px;
            cell: 60px;
            labels: ["AUTO", "OFF", "RED", "BLUE", "VIOLET"];
            index: Backend.led-mode;
            picked(i) => { Backend.led-mode = i; Backend.led-mode-selected(i); }
        }
    }
    Row {
        x: root.cx;
        y: 168px;
        width: root.cw;
        label: "Notifications";
        hint: "Show a small message when the audio mode or profile changes";
        Btn {
            x: parent.width - 110px;
            y: 11px;
            width: 110px;
            text: Backend.notifications ? "ENABLED" : "DISABLED";
            active: Backend.notifications;
            clicked => { Backend.notifications = !Backend.notifications; Backend.notifications-toggled(Backend.notifications); }
        }
    }
    Row {
        x: root.cx;
        y: 224px;
        width: root.cw;
        label: "Show on startup";
        hint: "Start hidden in the system tray when you sign in";
        Btn {
            x: parent.width - 110px;
            y: 11px;
            width: 110px;
            text: Backend.autostart ? "ENABLED" : "DISABLED";
            active: Backend.autostart;
            clicked => { Backend.autostart = !Backend.autostart; Backend.autostart-toggled(Backend.autostart); }
        }
    }
    Row {
        x: root.cx;
        y: 280px;
        width: root.cw;
        label: "Device";
        hint: Backend.connected ? "Connected" : "Not connected";
        Mono { x: parent.width - 200px; y: 0px; width: 200px; height: parent.height - 1px; text: "EPOS GSX 300"; horizontal-alignment: right; vertical-alignment: center; }
    }
    Row {
        x: root.cx;
        y: 336px;
        width: root.cw;
        label: "Software";
        hint: "Version";
        Mono { x: parent.width - 200px; y: 0px; width: 200px; height: parent.height - 1px; text: Backend.version; horizontal-alignment: right; vertical-alignment: center; }
    }
    Row {
        x: root.cx;
        y: 392px;
        width: root.cw;
        label: "Serial number";
        Mono { x: parent.width - 260px; y: 0px; width: 260px; height: parent.height - 1px; text: Backend.serial; horizontal-alignment: right; vertical-alignment: center; }
    }
    Row {
        x: root.cx;
        y: 448px;
        width: root.cw;
        label: "Official EPOS software";
        hint: Backend.official-issue == "" ? "Not running and not starting with Windows" : Backend.official-issue;
        Btn {
            x: parent.width - 110px;
            y: 11px;
            width: 110px;
            text: Backend.official-busy ? "WORKING" : "DISABLE";
            visible: Backend.official-issue != "";
            enabled: !Backend.official-busy;
            clicked => { Backend.official-disable(); }
        }
    }
}

export component MainWindow inherits Window {
    no-frame: true;
    width: 1040px;
    height: 600px;
    title: "EposControl";
    background: Theme.bg;
    default-font-family: Theme.body;
    default-font-size: 13px;
    property <int> page: 0;
    property <length> rail-w: 96px;

    Timer {
        interval: 33ms;
        running: root.page == 2 && Backend.window-visible;
        triggered => { Backend.poll-wave(); }
    }

    // Nav rail
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.rail-w;
        height: root.height;
        background: Theme.rail;
        TouchArea {
            height: 90px;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    Backend.drag-window();
                }
            }
        }
        Image {
            x: (parent.width - 34px) / 2;
            y: 28px;
            width: 34px;
            height: 34px;
            source: @image-url("../../../assets/icon-256.png");
            colorize: Theme.accent;
        }
        for nav[i] in [
            { icon: @image-url("../../../assets/icons/home.svg"), name: "HOME" },
            { icon: @image-url("../../../assets/icons/headphones.svg"), name: "HEADPHONES" },
            { icon: @image-url("../../../assets/icons/record_voice_over.svg"), name: "MICROPHONE" },
            { icon: @image-url("../../../assets/icons/settings.svg"), name: "SETTINGS" }
        ]: Rectangle {
            x: 0px;
            y: 100px + i * 80px;
            width: parent.width;
            height: 76px;
            background: root.page == i ? Theme.field : (ta.has-hover ? Theme.field.with-alpha(0.5) : transparent);
            Rectangle {
                x: 0px;
                y: 0px;
                width: 3px;
                height: parent.height;
                background: root.page == i ? Theme.accent : transparent;
            }
            Image {
                x: (parent.width - 26px) / 2;
                y: 16px;
                width: 26px;
                height: 26px;
                source: nav.icon;
                colorize: root.page == i ? Theme.accent : Theme.dim;
            }
            Text {
                x: 0px;
                y: 48px;
                width: parent.width;
                height: 12px;
                text: nav.name;
                horizontal-alignment: center;
                color: root.page == i ? Theme.text : Theme.dim;
                font-family: Theme.label;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 0.8px;
            }
            ta := TouchArea { clicked => { root.page = i; Backend.page-changed(i); } }
        }
    }

    // Top strip
    Rectangle {
        x: root.rail-w;
        y: 0px;
        width: root.width - root.rail-w;
        height: 56px;
        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    Backend.drag-window();
                }
            }
        }
        Text {
            x: 32px;
            y: 0px;
            height: parent.height;
            text: ["Home", "Headphones", "Microphone", "Settings"][root.page];
            color: Theme.text;
            font-family: Theme.body;
            font-size: 22px;
            font-weight: 600;
            vertical-alignment: center;
        }
        HorizontalLayout {
            x: 0px;
            y: 11px;
            width: parent.width - 16px;
            height: 34px;
            spacing: 8px;
            alignment: end;
            if root.page == 1: ProfileSelect {
                width: 170px;
                label: Backend.preset-label;
                items: Backend.preset-items;
                menu-width: 200px;
                picked(i) => { Backend.preset-selected(i); }
                deleted(i) => { Backend.preset-deleted(i); }
            }
            if root.page == 2: ProfileSelect {
                width: 170px;
                label: Backend.mic-preset-label;
                items: Backend.mic-preset-items;
                menu-width: 200px;
                picked(i) => { Backend.mic-preset-selected(i); }
                deleted(i) => { Backend.mic-preset-deleted(i); }
            }
            if root.page == 1 || root.page == 2: Btn {
                icon: @image-url("../../../assets/icons/add_box.svg");
                width: 36px;
                clicked => { name-pop.show(); }
            }
            Btn {
                text: "VOLUME";
                width: 96px;
                clicked => { Backend.refresh-volume(); vol.show(); }
            }
            Btn {
                icon: @image-url("../../../assets/icons/remove.svg");
                width: 36px;
                clicked => { Backend.minimize(); }
            }
            Btn {
                icon: @image-url("../../../assets/icons/close.svg");
                width: 36px;
                clicked => { Backend.close(); }
            }
        }
        Rule { x: 0px; y: parent.height - 1px; width: parent.width; }
    }
    vol := PopupWindow {
        x: root.width - 276px;
        y: 50px;
        width: 250px;
        height: 60px;
        Rectangle {
            background: Theme.field-hi;
            border-radius: Theme.r-md;
            border-width: 1px;
            border-color: Theme.rule;
            Slim {
                x: 16px;
                y: 16px;
                width: parent.width - 86px;
                value <=> Backend.volume;
                changed(v) => { Backend.volume-set(v); }
            }
            Mono { x: parent.width - 62px; y: 16px; width: 46px; height: 28px; text: round(Backend.volume * 100) + "%"; horizontal-alignment: right; vertical-alignment: center; }
        }
    }
    name-pop := PopupWindow {
        x: root.width - 380px;
        y: 50px;
        width: 340px;
        height: 100px;
        Rectangle {
            background: Theme.field-hi;
            border-radius: Theme.r-md;
            border-width: 1px;
            border-color: Theme.rule;
            Label { x: 16px; y: 14px; text: "SAVE THIS CURVE AS A PROFILE"; }
            Rectangle {
                x: 16px;
                y: 44px;
                width: 204px;
                height: 34px;
                background: Theme.field;
                border-radius: Theme.r-sm;
                border-width: 1px;
                border-color: Theme.rule;
                name-input := TextInput {
                    x: 10px;
                    y: 0px;
                    width: parent.width - 20px;
                    height: parent.height;
                    color: Theme.text;
                    font-family: Theme.mono;
                    font-size: 13px;
                    vertical-alignment: center;
                    text: "";
                    accepted => {
                        if (root.page == 2) { Backend.mic-preset-add(self.text); } else { Backend.preset-add(self.text); }
                        self.text = "";
                    }
                }
            }
            Btn {
                x: 232px;
                y: 44px;
                width: 92px;
                text: "SAVE";
                clicked => {
                    if (root.page == 2) { Backend.mic-preset-add(name-input.text); } else { Backend.preset-add(name-input.text); }
                    name-input.text = "";
                }
            }
        }
    }

    // Pages
    if root.page == 0: HomePage { x: root.rail-w; y: 56px; width: root.width - root.rail-w; height: root.height - 56px; }
    if root.page == 1: HeadphonesPage { x: root.rail-w; y: 56px; width: root.width - root.rail-w; height: root.height - 56px; }
    if root.page == 2: MicPage { x: root.rail-w; y: 56px; width: root.width - root.rail-w; height: root.height - 56px; }
    if root.page == 3: SettingsPage { x: root.rail-w; y: 56px; width: root.width - root.rail-w; height: root.height - 56px; }
}

// Small overlay shown in the bottom left when the audio mode or profile changes.
export component ToastWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    width: 380px;
    height: 88px;
    background: transparent;
    in property <string> message;
    in property <color> accent: #3b8cff;
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        border-radius: Theme.r-lg;
        background: #101216f0;
        border-width: 1px;
        border-color: root.accent.with-alpha(0.55);
        Image {
            x: 22px;
            y: (parent.height - 40px) / 2;
            width: 40px;
            height: 40px;
            source: @image-url("../../../assets/icon-256.png");
            colorize: root.accent;
        }
        Text {
            x: 80px;
            y: 0px;
            width: parent.width - 96px;
            height: parent.height;
            text: root.message;
            color: Theme.text;
            font-family: Theme.label;
            font-size: 20px;
            font-weight: 600;
            letter-spacing: 1.2px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
