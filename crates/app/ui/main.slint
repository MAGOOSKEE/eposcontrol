import { Switch, Palette, ComboBox, LineEdit } from "std-widgets.slint";

component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 44px;
    border-radius: 22px;
    background: root.active ? Palette.accent-background.with-alpha(0.20)
        : area.has-hover ? Palette.foreground.with-alpha(0.07) : transparent;
    HorizontalLayout {
        padding-left: 16px;
        spacing: 14px;
        alignment: start;
        Image {
            source: root.icon;
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            colorize: Palette.foreground;
        }
        Text {
            text: root.label;
            color: Palette.foreground;
            font-size: 14px;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
        }
    }
    area := TouchArea { clicked => { root.clicked(); } }
}

component Card inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    min-height: 68px;
    border-radius: 12px;
    background: Palette.alternate-background;
    HorizontalLayout {
        padding: 14px;
        padding-left: 18px;
        padding-right: 18px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: root.title; color: Palette.foreground; font-size: 15px; }
            Text {
                text: root.subtitle;
                color: Palette.foreground.with-alpha(0.65);
                font-size: 12px;
                wrap: word-wrap;
            }
        }
        @children
    }
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <color> dot;
    in property <bool> selected;
    callback clicked;
    width: 92px;
    height: 36px;
    border-radius: 18px;
    border-width: 1px;
    border-color: root.selected ? Palette.accent-background : Palette.foreground.with-alpha(0.25);
    background: root.selected ? Palette.accent-background.with-alpha(0.22)
        : area.has-hover ? Palette.foreground.with-alpha(0.07) : transparent;
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        Rectangle {
            width: 12px;
            height: 12px;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            background: root.dot;
            border-width: 1px;
            border-color: Palette.foreground.with-alpha(0.3);
        }
        Text { text: root.label; color: Palette.foreground; font-size: 13px; vertical-alignment: center; }
    }
    area := TouchArea { clicked => { root.clicked(); } }
}

export component MainWindow inherits Window {
    title: "EposControl";
    min-width: 700px;
    min-height: 460px;
    preferred-width: 860px;
    preferred-height: 560px;
    background: Palette.background;

    in property <bool> connected;
    in property <[string]> action-names;
    in property <string> param-hint;
    in property <bool> param-visible;
    in-out property <int> led-index;
    in-out property <int> action-index;
    in-out property <string> action-param;
    in-out property <bool> autostart;
    callback led-selected(int);
    callback action-selected(int);
    callback param-edited(string);
    callback autostart-toggled(bool);
    property <int> page: 0;

    HorizontalLayout {
        Rectangle {
            width: 230px;
            background: Palette.alternate-background;
            VerticalLayout {
                padding: 16px;
                spacing: 6px;
                alignment: start;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-bottom: 18px;
                    spacing: 12px;
                    Image {
                        source: @image-url("../../../assets/icons/headset_mic.svg");
                        width: 28px;
                        height: 28px;
                        colorize: Palette.accent-background;
                    }
                    Text {
                        text: "EposControl";
                        font-size: 18px;
                        font-weight: 700;
                        color: Palette.foreground;
                        vertical-alignment: center;
                    }
                }
                NavItem {
                    icon: @image-url("../../../assets/icons/usb.svg");
                    label: "Device";
                    active: root.page == 0;
                    clicked => { root.page = 0; }
                }
                NavItem {
                    icon: @image-url("../../../assets/icons/tune.svg");
                    label: "Button";
                    active: root.page == 1;
                    clicked => { root.page = 1; }
                }
                NavItem {
                    icon: @image-url("../../../assets/icons/settings.svg");
                    label: "Settings";
                    active: root.page == 2;
                    clicked => { root.page = 2; }
                }
            }
        }

        VerticalLayout {
            padding: 32px;
            spacing: 14px;
            alignment: start;

            if root.page == 0: VerticalLayout {
                spacing: 14px;
                Text { text: "Device"; font-size: 26px; font-weight: 700; color: Palette.foreground; }
                Card {
                    title: "EPOS GSX 300";
                    subtitle: root.connected ? "Connected" : "Not connected";
                    Rectangle {
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        y: (parent.height - self.height) / 2;
                        background: root.connected ? #2e9e5b : #9aa0a6;
                    }
                }
                Card {
                    title: "Knob light";
                    subtitle: "Colour of the light on the volume knob";
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        Chip { label: "Off"; dot: #00000000; selected: root.led-index == 0; clicked => { root.led-selected(0); } }
                        Chip { label: "Red"; dot: #e53935; selected: root.led-index == 1; clicked => { root.led-selected(1); } }
                        Chip { label: "Blue"; dot: #1e88e5; selected: root.led-index == 2; clicked => { root.led-selected(2); } }
                        Chip { label: "Purple"; dot: #8e24aa; selected: root.led-index == 3; clicked => { root.led-selected(3); } }
                    }
                }
            }

            if root.page == 1: VerticalLayout {
                spacing: 14px;
                Text { text: "Smart button"; font-size: 26px; font-weight: 700; color: Palette.foreground; }
                Card {
                    title: "When pressed";
                    subtitle: "Choose what the smart button does";
                    ComboBox {
                        width: 270px;
                        model: root.action-names;
                        current-index: root.action-index;
                        selected(s) => { root.action-selected(self.current-index); }
                    }
                }
                if root.param-visible: Card {
                    title: "Details";
                    subtitle: root.param-hint;
                    LineEdit {
                        width: 270px;
                        text: root.action-param;
                        edited(t) => { root.param-edited(t); }
                    }
                }
            }

            if root.page == 2: VerticalLayout {
                spacing: 14px;
                Text { text: "Settings"; font-size: 26px; font-weight: 700; color: Palette.foreground; }
                Card {
                    title: "Launch at startup";
                    subtitle: "Start silently in the system tray when you sign in";
                    Switch {
                        checked <=> root.autostart;
                        toggled => { root.autostart-toggled(self.checked); }
                    }
                }
            }
        }
    }
}
