{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EposControl",
  "version": "0.1.0",
  "identifier": "com.eposcontrol.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "EposControl",
        "width": 880,
        "height": 600,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
